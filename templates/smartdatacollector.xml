<Container version="2">
  <Name>smartdatacollector</Name>
  <Repository>ghcr.io/bertyboynz/smartdatacollector:latest</Repository>
  <Registry>https://github.com/bertyboynz/smartdatacollector/pkgs/container/smartdatacollector</Registry>
  <Network>bridge</Network>

  <Privileged>true</Privileged>

  <Icon>https://raw.githubusercontent.com/bertyboynz/smartdatacollector/main/icon.png</Icon>

  <WebUI>http://[IP]:[PORT:8080]</WebUI>

  <Overview>Monitor SMART data from your Unraid drives over time with a web dashboard. Tracks drive health metrics, shows historical trends, and alerts you to potential issues before they become critical.</Overview>

  <Support>https://forums.unraid.net/topic/XXXXX-smart-data-collector/</Support>
  <Project>https://github.com/bertyboynz/smartdatacollector</Project>

  <TemplateURL>https://raw.githubusercontent.com/bertyboynz/smartdatacollector/main/templates/smartdatacollector.xml</TemplateURL>
  <ReadMe>https://raw.githubusercontent.com/bertyboynz/smartdatacollector/main/README.md</ReadMe>

  <Category>Tools:System</Category>
  <ExtraSearchTerms>smart smartctl hard drive health monitoring disk</ExtraSearchTerms>

  <MinVer>6.1</MinVer>
  <License>MIT</License>

  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="HTTP port for the WebUI" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="Appdata" Target="/app/data" Default="/mnt/user/appdata/smartdatacollector" Mode="rw" Description="Persistent storage for SQLite database" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Timezone" Target="TZ" Description="Container timezone (e.g. Pacific/Auckland, UTC)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>